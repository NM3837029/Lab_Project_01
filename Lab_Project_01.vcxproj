      <!-- 【重要】/execution-charset:utf-8 が無いと、ソース中の日本語を含む narrow 文字列リテラル
           （例: LoadGraph("img/プレイヤー.png")）が実行時文字セット＝システムANSI(CP932)へ
           変換されて出力される。一方 DrawPixel.cpp は SetUseCharCodeFormat(DX_CHARCODEFORMAT_UTF8) で
           「DxLibへ渡す文字列はUTF-8」と宣言しているため、両者が食い違って
           日本語ファイル名の画像が一枚も読み込めなくなる（LoadGraphが黙って-1を返す）。
           JSON由来のパスは元からUTF-8なので、リテラル側もUTF-8へ揃えて統一する。
           /utf-8 ではなく /execution-charset:utf-8 だけを指定しているのは、
           /utf-8 だとソース文字セットまでUTF-8固定になり、Shift-JISで書かれた
           DxLib.h のコメントが警告C4828の山を吐くため。自作ソースは全てBOM付きUTF-8なので、
           ソース側の判定はBOM任せで問題ない。 -->
      <AdditionalOptions>/execution-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>WIN32;_DEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>DxLib_VC\プロジェクトに追加すべきファイル_VC用;imgui;imgui\backends</AdditionalIncludeDirectories>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <BufferSecurityCheck>false</BufferSecurityCheck>
    </ClCompile>
